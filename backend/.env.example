GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URLs used by OAuth redirects and CORS.
FRONTEND_APP_URL=http://localhost:3001
FRONTEND_APP_ORIGINS=http://localhost:3001

# Backend URL used for generated links in development.
BACKEND_APP_HOST=localhost
BACKEND_APP_PORT=3000

# Session cookie settings.
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# AI provider configuration.
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=
